{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "binaryDir": "${sourceDir}/build/debug",
      "toolchainFile": "${sourceDir}/external/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build/debug/bin",
        "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/build/debug/lib",
        "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/build/debug/lib",
        "CMAKE_LINKER_TYPE": "LLD",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "26",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_MANIFEST_MODE": "ON",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/Environment.cmake",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_MANIFEST_MODE": "ON",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build/release/bin",
        "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/build/release/lib",
        "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/build/release/lib"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "debug-unit",
      "configurePreset": "debug",
      "targets": [
        "DotUnitTests"
      ]
    },
    {
      "name": "release-unit",
      "configurePreset": "release",
      "targets": [
        "DotUnitTests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": 4
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": 4
      }
    },
    {
      "name": "debug-unit",
      "inherits": "debug",
      "displayName": "Debug unit",
      "filter": {
        "include": {
          "label": "^unit$"
        }
      }
    },
    {
      "name": "debug-integration",
      "inherits": "debug",
      "displayName": "Debug integration",
      "filter": {
        "include": {
          "label": "^integration$"
        },
        "exclude": {
          "label": "^(gpu|native|audio-native)$"
        }
      }
    },
    {
      "name": "debug-gpu",
      "inherits": "debug",
      "displayName": "Debug gpu",
      "filter": {
        "include": {
          "label": "^offscreen$"
        }
      }
    },
    {
      "name": "release-unit",
      "inherits": "release",
      "displayName": "Release unit",
      "filter": {
        "include": {
          "label": "^unit$"
        }
      }
    },
    {
      "name": "release-integration",
      "inherits": "release",
      "displayName": "Release integration",
      "filter": {
        "include": {
          "label": "^integration$"
        },
        "exclude": {
          "label": "^(gpu|native|audio-native)$"
        }
      }
    },
    {
      "name": "release-gpu",
      "inherits": "release",
      "displayName": "Release gpu",
      "filter": {
        "include": {
          "label": "^offscreen$"
        }
      }
    }
  ]
}
