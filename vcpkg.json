{
  "name": "dot-engine",
  "version-string": "0.1.0",
  "dependencies": [
    "doctest",
    "sdl3",
    "glm",
    "nlohmann-json",
    "tinyobjloader",
    "stb",
    "entt",
    "miniaudio",
    "dot-editor-font",
    {
      "name": "imgui",
      "default-features": false,
      "features": [
        "docking-experimental",
        "sdl3-binding",
        "webgpu-binding",
        "wchar32",
        "freetype"
      ]
    },
    {
      "name": "quickjs-ng",
      "default-features": false
    },
    {
      "name": "joltphysics",
      "features": [
        "rtti"
      ]
    },
    {
      "name": "dawn",
      "default-features": false,
      "features": [
        {
          "name": "metal",
          "platform": "osx"
        },
        {
          "name": "d3d12",
          "platform": "windows"
        },
        {
          "name": "vulkan",
          "platform": "linux"
        },
        {
          "name": "x11",
          "platform": "linux"
        },
        {
          "name": "wayland",
          "platform": "linux"
        }
      ]
    },
    {
      "name": "vcpkg-tool-typescript",
      "host": true
    }
  ],
  "builtin-baseline": "e456309491fd875487bf02b8a0dca76c1b1b00cc",
  "overrides": [
    { "name": "dot-editor-font", "version-string": "1.0.42" },
    {
      "name": "imgui",
      "version": "1.92.9",
      "port-version": 1
    },
    {
      "name": "quickjs-ng",
      "version": "0.16.2",
      "port-version": 1
    },
    {
      "name": "vcpkg-tool-typescript",
      "version": "7.0.2"
    }
  ]
}
