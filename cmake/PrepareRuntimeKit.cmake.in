cmake_minimum_required(VERSION 3.31)
set(dot_kit "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(dot_executable "${dot_kit}/DotGame@CMAKE_EXECUTABLE_SUFFIX@")
set(dot_search "@DOT_KIT_SEARCH@")

if("@CMAKE_SYSTEM_NAME@" STREQUAL "Darwin")
    include(BundleUtilities)
    function(gp_item_default_embedded_path_override item result)
        set(${result} "@executable_path/lib" PARENT_SCOPE)
    endfunction()
    fixup_bundle("${dot_executable}" "" "${dot_search}")
    find_program(dot_codesign codesign REQUIRED)
    file(GLOB dot_libraries "${dot_kit}/lib/*")
    foreach(dot_file IN LISTS dot_libraries)
        execute_process(COMMAND "${dot_codesign}" --force --sign - "${dot_file}"
            COMMAND_ERROR_IS_FATAL ANY)
    endforeach()
    execute_process(COMMAND "${dot_codesign}" --force --sign - "${dot_executable}"
        COMMAND_ERROR_IS_FATAL ANY)
elseif("@CMAKE_SYSTEM_NAME@" STREQUAL "Windows")
    file(GET_RUNTIME_DEPENDENCIES EXECUTABLES "${dot_executable}"
        RESOLVED_DEPENDENCIES_VAR dot_dependencies
        DIRECTORIES ${dot_search}
        PRE_EXCLUDE_REGEXES "api-ms-" "ext-ms-"
        POST_EXCLUDE_REGEXES "[Ww][Ii][Nn][Dd][Oo][Ww][Ss]/[Ss][Yy][Ss][Tt][Ee][Mm]32")
    foreach(dot_file IN LISTS dot_dependencies)
        file(COPY "${dot_file}" DESTINATION "${dot_kit}" FOLLOW_SYMLINK_CHAIN)
    endforeach()
else()
    file(GET_RUNTIME_DEPENDENCIES EXECUTABLES "${dot_executable}"
        RESOLVED_DEPENDENCIES_VAR dot_dependencies
        DIRECTORIES ${dot_search}
        PRE_EXCLUDE_REGEXES "^ld-linux" "^lib(c|m|pthread|dl|rt)\\.so")
    foreach(dot_file IN LISTS dot_dependencies)
        file(COPY "${dot_file}" DESTINATION "${dot_kit}/lib" FOLLOW_SYMLINK_CHAIN)
    endforeach()
endif()


if(NOT "@CMAKE_SYSTEM_NAME@" STREQUAL "Darwin")
    if("@CMAKE_SYSTEM_NAME@" STREQUAL "Windows")
        file(GET_RUNTIME_DEPENDENCIES EXECUTABLES "${dot_executable}"
            RESOLVED_DEPENDENCIES_VAR dot_verified
            DIRECTORIES "${dot_kit}"
            PRE_EXCLUDE_REGEXES "api-ms-" "ext-ms-"
            POST_EXCLUDE_REGEXES "[Ww][Ii][Nn][Dd][Oo][Ww][Ss]/[Ss][Yy][Ss][Tt][Ee][Mm]32")
    else()
        file(GET_RUNTIME_DEPENDENCIES EXECUTABLES "${dot_executable}"
            RESOLVED_DEPENDENCIES_VAR dot_verified
            PRE_EXCLUDE_REGEXES "^ld-linux" "^lib(c|m|pthread|dl|rt)\\.so")
    endif()
    foreach(dot_file IN LISTS dot_verified)
        file(RELATIVE_PATH dot_relative "${dot_kit}" "${dot_file}")
        if(dot_relative MATCHES "^\\.\\./" OR IS_ABSOLUTE "${dot_relative}")
            message(FATAL_ERROR "Packaged runtime still depends on an external library: ${dot_file}")
        endif()
    endforeach()
endif()

set(dot_files "[]")
file(GLOB_RECURSE dot_entries LIST_DIRECTORIES FALSE RELATIVE "${dot_kit}" "${dot_kit}/*")
list(SORT dot_entries)
set(dot_index 0)
foreach(dot_relative IN LISTS dot_entries)
    if(dot_relative STREQUAL "runtime.json")
        continue()
    endif()
    if(IS_SYMLINK "${dot_kit}/${dot_relative}")
        file(REAL_PATH "${dot_kit}/${dot_relative}" dot_real)
        file(REMOVE "${dot_kit}/${dot_relative}")
        file(COPY_FILE "${dot_real}" "${dot_kit}/${dot_relative}")
    endif()
    file(SIZE "${dot_kit}/${dot_relative}" dot_size)
    string(JSON dot_entry SET "{}" path "\"${dot_relative}\"")
    string(JSON dot_entry SET "${dot_entry}" bytes ${dot_size})
    string(JSON dot_files SET "${dot_files}" ${dot_index} "${dot_entry}")
    math(EXPR dot_index "${dot_index}+1")
endforeach()
set(dot_manifest "{}")
string(JSON dot_manifest SET "${dot_manifest}" version 1)
string(JSON dot_manifest SET "${dot_manifest}" platform "\"@DOT_KIT_PLATFORM@\"")
string(JSON dot_manifest SET "${dot_manifest}" executable "\"DotGame@CMAKE_EXECUTABLE_SUFFIX@\"")
string(JSON dot_manifest SET "${dot_manifest}" files "${dot_files}")
file(WRITE "${dot_kit}/runtime.json" "${dot_manifest}\n")
