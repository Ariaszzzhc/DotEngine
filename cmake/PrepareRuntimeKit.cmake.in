cmake_minimum_required(VERSION 3.31)
set(dot_kit "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(dot_executable "${dot_kit}/DotGame@CMAKE_EXECUTABLE_SUFFIX@")
set(dot_search "@DOT_KIT_SEARCH@")

include("@CMAKE_CURRENT_BINARY_DIR@/FixNativeDependencies.cmake")

set(dot_files "[]")
file(GLOB_RECURSE dot_entries LIST_DIRECTORIES FALSE RELATIVE "${dot_kit}" "${dot_kit}/*")
list(SORT dot_entries)
set(dot_index 0)
foreach(dot_relative IN LISTS dot_entries)
    if(dot_relative STREQUAL "runtime.json")
        continue()
    endif()
    if(IS_SYMLINK "${dot_kit}/${dot_relative}")
        file(REAL_PATH "${dot_kit}/${dot_relative}" dot_real)
        file(REMOVE "${dot_kit}/${dot_relative}")
        file(COPY_FILE "${dot_real}" "${dot_kit}/${dot_relative}")
    endif()
    file(SIZE "${dot_kit}/${dot_relative}" dot_size)
    string(JSON dot_entry SET "{}" path "\"${dot_relative}\"")
    string(JSON dot_entry SET "${dot_entry}" bytes ${dot_size})
    string(JSON dot_files SET "${dot_files}" ${dot_index} "${dot_entry}")
    math(EXPR dot_index "${dot_index}+1")
endforeach()
set(dot_manifest "{}")
string(JSON dot_manifest SET "${dot_manifest}" version 1)
string(JSON dot_manifest SET "${dot_manifest}" platform "\"@DOT_KIT_PLATFORM@\"")
string(JSON dot_manifest SET "${dot_manifest}" executable "\"DotGame@CMAKE_EXECUTABLE_SUFFIX@\"")
string(JSON dot_manifest SET "${dot_manifest}" files "${dot_files}")
file(WRITE "${dot_kit}/runtime.json" "${dot_manifest}\n")
