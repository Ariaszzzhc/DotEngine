{
  "name": "imgui",
  "version": "1.92.9",
  "port-version": 1,
  "description": "Dear ImGui with only DotEngine's pinned backends",
  "homepage": "https://github.com/ocornut/imgui",
  "license": "MIT",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "freetype": {
      "description": "Validated font loading and rasterization",
      "dependencies": [
        "freetype"
      ]
    },
    "docking-experimental": {
      "description": "Docking support"
    },
    "wchar32": {
      "description": "Unicode code points"
    },
    "sdl3-binding": {
      "description": "SDL3 input backend",
      "dependencies": [
        "sdl3"
      ]
    },
    "webgpu-binding": {
      "description": "WebGPU backend without implicit Dawn default backends",
      "dependencies": [
        {
          "name": "dawn",
          "default-features": false
        }
      ]
    }
  }
}
