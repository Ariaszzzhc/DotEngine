module;

#include <filesystem>
#include <memory>

export module Dot.Project.GameExport;

import Dot.Core.Result;
import Dot.Core.Files;
import Dot.Project;
import Dot.World.Scene;
import Dot.Script.Compiler;

export namespace Dot::Project {
  /** Validated native runtime kit with borrowed files, generated by this build.
   * Input changes must be serialized. Exact manifest/tree/size checks do not
   * authenticate executable bytes. Limits: 512 files, 512 MiB each, 1 GiB total,
   * 1024 visited entries, 16 levels and 1 MiB manifest. On macOS bounded regular
   * .DS_Store files (64 KiB) are ignored and not copied. Keep source files alive.
   * 限额为 512 文件、单个 512 MiB、总共 1 GiB、1024 条目、16 层及 1 MiB 清单；
   * macOS 的普通 .DS_Store（64 KiB）忽略且不复制。
   * 本构建生成的已校验原生运行时目录，借用文件；输入变化须串行。精确清单/树/大小校验
   * 不认证可执行字节，源文件须存活到导出结束。 */
  class RuntimeKit {
  public:
    [[nodiscard]] static auto open(const Core::FileSystem& files) -> Core::Result<RuntimeKit>;
    RuntimeKit(const RuntimeKit&) noexcept;
    auto operator=(const RuntimeKit&) noexcept -> RuntimeKit&;
    RuntimeKit(RuntimeKit&&) noexcept;
    auto operator=(RuntimeKit&&) noexcept -> RuntimeKit&;
    ~RuntimeKit();
    /** Copy a revalidated kit into a new owned directory, preserving executable
     * permissions and every notice; never replace an existing destination.
     * 将重新校验的运行时复制到新拥有目录，保留执行权限及全部声明，不覆盖已有目标。 */
    [[nodiscard]] auto publish(const Core::FileSystem& parent,
                               const std::filesystem::path& folder) const
        -> Core::Result<Core::FileSystem>;

  private:
    struct Impl;
    explicit RuntimeKit(std::shared_ptr<const Impl> impl) noexcept;
    std::shared_ptr<const Impl> m_impl;
  };

  /** Export a native kit plus current scene/resource/ESM package as one exclusive
   * directory publication. Authoring data is never implicitly saved. The kit must
   * match this build's native platform; cross-platform exports require native kits.
   * 将原生运行时及当前场景/资源/ESM 包一次独占发布，不隐式保存编辑数据。运行时须匹配
   * 当前构建平台，跨平台导出需要对应原生构建。 */
  [[nodiscard]] auto exportGame(const Project& project, const World::Scene& scene,
                                const Script::TypeScriptCompiler& compiler,
                                const RuntimeKit& runtime, const Core::FileSystem& parent,
                                const std::filesystem::path& folder)
      -> Core::Result<Core::FileSystem>;
}  // namespace Dot::Project
